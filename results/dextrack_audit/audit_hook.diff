+            "goal_pos": self.goal_pos[0].detach().cpu().numpy().copy() if hasattr(self, "goal_pos") else None,
+            "goal_rot": self.goal_rot[0].detach().cpu().numpy().copy() if hasattr(self, "goal_rot") else None,
+            "hand_dof_pos": self.shadow_hand_dof_pos[0].detach().cpu().numpy().copy(),
